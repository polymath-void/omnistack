{
  "agy-nodeos-boot": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "nodeos -d",
        "timeout": 15
      }
    ]
  },
  "nodeos-swarm-intent": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "nodeos -s intent_injector"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "nodeos -s intent_stopper"
      }
    ]
  }
}
